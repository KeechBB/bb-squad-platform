generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  HR
  DEPUTY
  SUPER_ADMIN
}

enum ClanRole {
  LEADER
  DEPUTY
  MAIN
  SUB
  RESERVE
  MEMBER
}

enum ClanInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ClanJoinRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model User {
  id              String   @id @default(cuid())
  steamId         String   @unique
  steamName       String?
  steamAvatar     String?
  avatarUrl       String?
  name            String?
  nick            String?  @unique
  age             Int?
  birthDate       DateTime?
  discordTag      String?
  discordId       String?
  telegram        String?
  reserveUntil    DateTime?
  reserveReason   String?
  role            Role     @default(USER)
  profileComplete Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clanMemberships ClanMember[]
  clanInvites     ClanInvite[] @relation("Invitee")
  sentInvites     ClanInvite[] @relation("Inviter")
  ledClans        Clan[]       @relation("ClanLeader")
  squadMemberships ClanSquadMember[]
  clanJoinRequests ClanJoinRequest[] @relation("JoinApplicant")
  reviewedJoinRequests ClanJoinRequest[] @relation("JoinReviewer")
}

model Clan {
  id        String   @id @default(cuid())
  name      String
  tag       String   @unique
  logoUrl   String?
  leaderId  String
  leader    User     @relation("ClanLeader", fields: [leaderId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      ClanMember[]
  invites      ClanInvite[]
  squads       ClanSquad[]
  titles       ClanTitle[]
  joinRequests ClanJoinRequest[]
}

model ClanTitle {
  id        String   @id @default(cuid())
  clanId    String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  clan    Clan         @relation(fields: [clanId], references: [id], onDelete: Cascade)
  members ClanMember[]

  @@unique([clanId, name])
  @@index([clanId])
}

model ClanSquad {
  id        String   @id @default(cuid())
  clanId    String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  clan    Clan              @relation(fields: [clanId], references: [id], onDelete: Cascade)
  members ClanSquadMember[]

  @@unique([clanId, name])
  @@index([clanId])
}

model ClanSquadMember {
  id       String   @id @default(cuid())
  squadId  String
  userId   String
  joinedAt DateTime @default(now())

  squad ClanSquad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([squadId, userId])
  @@index([userId])
}

model ClanMember {
  id                String    @id @default(cuid())
  clanId            String
  userId            String
  role              ClanRole  @default(MEMBER)
  roleBeforeReserve ClanRole?
  titleId           String?
  joinedAt          DateTime  @default(now())

  clan  Clan       @relation(fields: [clanId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title ClanTitle? @relation(fields: [titleId], references: [id], onDelete: SetNull)

  @@unique([clanId, userId])
  @@index([userId])
  @@index([titleId])
}

model ClanInvite {
  id        String           @id @default(cuid())
  clanId    String
  userId    String
  invitedBy String
  status    ClanInviteStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  clan    Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)
  user    User @relation("Invitee", fields: [userId], references: [id], onDelete: Cascade)
  inviter User @relation("Inviter", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([clanId, userId])
  @@index([userId, status])
}

model ClanJoinRequest {
  id         String                 @id @default(cuid())
  clanId     String
  userId     String
  status     ClanJoinRequestStatus  @default(PENDING)
  reviewedBy String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  clan     Clan  @relation(fields: [clanId], references: [id], onDelete: Cascade)
  user     User  @relation("JoinApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("JoinReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([clanId, status])
  @@index([userId, status])
}
