generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  HR
  DEPUTY
  SUPER_ADMIN
}

enum ClanRole {
  LEADER
  DEPUTY
  MAIN
  SUB
  RESERVE
  MEMBER
}

enum ClanInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ClanJoinRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model User {
  id              String   @id @default(cuid())
  steamId         String   @unique
  steamName       String?
  steamAvatar     String?
  avatarUrl       String?
  name            String?
  nick            String?  @unique
  age             Int?
  birthDate       DateTime?
  discordTag      String?
  discordId       String?
  telegram        String?
  reserveUntil    DateTime?
  reserveReason   String?
  role            Role     @default(USER)
  profileComplete Boolean  @default(false)
  /// Постоянный номер регистрации (1 = первый). Не пересчитывается при удалении других.
  regNo           Int?     @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  /// Последняя активность на сайте (heartbeat из браузера)
  lastSeenAt      DateTime?

  clanMemberships ClanMember[]
  clanInvites     ClanInvite[] @relation("Invitee")
  sentInvites     ClanInvite[] @relation("Inviter")
  ledClans        Clan[]       @relation("ClanLeader")
  squadMemberships ClanSquadMember[]
  clanJoinRequests ClanJoinRequest[] @relation("JoinApplicant")
  reviewedJoinRequests ClanJoinRequest[] @relation("JoinReviewer")
  squadSessions   SquadServerSession[]
  reactionRuns    ReactionRun[]
  reactionPresence ReactionPresence?
  reactionChatMessages ReactionChatMessage[]
  pageVisits      SitePageVisit[]
  siteVisitors    SiteVisitor[]
}

/// Серия тренировки: ур.1 среднее мс; ур.2 очки шариков в avgMs
model ReactionRun {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     Int      @default(1)
  /// Ур.1: среднее мс; ур.2: итоговый счёт
  avgMs     Float
  /// Ур.1: 10 попыток в мс; ур.2: { hits, misses, score }
  attempts  Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([avgMs])
  @@index([level, avgMs])
}

/// Кто сейчас на вкладке «Тренировка стрельбы»
model ReactionPresence {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Последний средний результат в этой сессии на вкладке (мс)
  lastAvgMs   Float?
  /// Последняя серия ур.1 / ур.2
  lastAvgL1Ms Float?
  lastAvgL2Ms Float?
  updatedAt   DateTime @updatedAt
}

/// Сообщения чата на вкладке тренировки (живут ~30 мин)
model ReactionChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Clan {
  id        String   @id @default(cuid())
  name      String
  tag       String   @unique
  logoUrl   String?
  leaderId  String
  leader    User     @relation("ClanLeader", fields: [leaderId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      ClanMember[]
  invites      ClanInvite[]
  squads       ClanSquad[]
  titles       ClanTitle[]
  joinRequests ClanJoinRequest[]
}

model ClanTitle {
  id        String   @id @default(cuid())
  clanId    String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  clan    Clan         @relation(fields: [clanId], references: [id], onDelete: Cascade)
  members ClanMember[]

  @@unique([clanId, name])
  @@index([clanId])
}

model ClanSquad {
  id        String   @id @default(cuid())
  clanId    String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  clan    Clan              @relation(fields: [clanId], references: [id], onDelete: Cascade)
  members ClanSquadMember[]

  @@unique([clanId, name])
  @@index([clanId])
}

model ClanSquadMember {
  id       String   @id @default(cuid())
  squadId  String
  userId   String
  joinedAt DateTime @default(now())

  squad ClanSquad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([squadId, userId])
  @@index([userId])
}

model ClanMember {
  id                String    @id @default(cuid())
  clanId            String
  userId            String
  role              ClanRole  @default(MEMBER)
  roleBeforeReserve ClanRole?
  titleId           String?
  joinedAt          DateTime  @default(now())

  clan  Clan       @relation(fields: [clanId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title ClanTitle? @relation(fields: [titleId], references: [id], onDelete: SetNull)

  @@unique([clanId, userId])
  @@index([userId])
  @@index([titleId])
}

model ClanInvite {
  id        String           @id @default(cuid())
  clanId    String
  userId    String
  invitedBy String
  status    ClanInviteStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  clan    Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)
  user    User @relation("Invitee", fields: [userId], references: [id], onDelete: Cascade)
  inviter User @relation("Inviter", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([clanId, userId])
  @@index([userId, status])
}

model ClanJoinRequest {
  id         String                 @id @default(cuid())
  clanId     String
  userId     String
  status     ClanJoinRequestStatus  @default(PENDING)
  reviewedBy String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  clan     Clan  @relation(fields: [clanId], references: [id], onDelete: Cascade)
  user     User  @relation("JoinApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("JoinReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([clanId, status])
  @@index([userId, status])
}

/// Сессия на игровом сервере Squad (join → leave) для юзеров сайта.
model SquadServerSession {
  id         String    @id @default(cuid())
  userId     String
  steamId    String
  eosId      String?
  nickAtJoin String?
  serverKey  String    @default("TPUB1")
  joinedAt   DateTime
  leftAt     DateTime?
  /// Идемпотентность: serverKey|steamId|joinedAtUnix
  eventKey   String    @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, joinedAt])
  @@index([steamId, joinedAt])
  @@index([serverKey, leftAt])
}

/// Кэш связки EOS ↔ Steam из логов (для парсера/ингеста).
model SquadEosSteamMap {
  eosId     String   @id
  steamId   String
  nick      String?
  updatedAt DateTime @updatedAt

  @@index([steamId])
}

/// Уникальный посетитель сайта (cookie/localStorage id). Читать только Keech.
model SiteVisitor {
  id           String   @id @default(cuid())
  /// Стабильный id из браузера (localStorage)
  clientKey    String   @unique
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @updatedAt
  /// Связка после логина / регистрации
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Первый реферер (откуда пришёл)
  referrer     String?
  /// Первый путь (лендинг)
  landingPath  String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  /// Краткий user-agent
  userAgent    String?
  visits       SitePageVisit[]

  @@index([userId])
  @@index([firstSeenAt])
  @@index([referrer])
}

/// Заходы на страницы (гости + залогиненные). Читать только Keech.
model SitePageVisit {
  id        String   @id @default(cuid())
  visitorId String?
  visitor   SiteVisitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Путь без query
  path      String
  nickAt    String?
  referrer  String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([visitorId, createdAt])
  @@index([createdAt])
  @@index([path, createdAt])
}

/// Накопительный журнал действий (админ-права, клан, профиль).
model ActionLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  /// admin | clan | profile
  category   String
  /// role_set, invite, kick, join, leave, create_clan, disband, …
  action     String
  /// Человекочитаемая строка для чата и поиска
  message    String
  /// Нижний регистр message + ники для ILIKE-поиска
  searchText String
  actorId    String?
  actorNick  String?
  targetId   String?
  targetNick String?
  clanId     String?
  clanTag    String?
  meta       Json?

  @@index([createdAt])
  @@index([category])
  @@index([action])
  @@index([searchText])
}
