# Скопируй в recruit-bot.env рядом с bot.py. Файл с токеном в git не коммитится.

# Токен от @BotFather
BOT_TOKEN=

# HR-чат (Bot для набора): шаги 1–4, алерты, кураторы. Бот админ. -100...
ALERT_CHAT_ID=
ALERT_THREAD_ID=
# Публичный чат (Основной): ТОЛЬКО финал «Новый участник клана …». -100...
ANNOUNCE_CHAT_ID=
ANNOUNCE_THREAD_ID=

# Канал: бот админ + право приглашать по ссылке.
# CHANNEL_URL / GROUP_URL — запасной вариант; обычно бот сам выдаёт одноразовые.
CHANNEL_ID=
CHANNEL_URL=
CHANNEL_TITLE=канал

# Группа: бот админ + приглашать по ссылке + изменение тегов участников.
GROUP_ID=
GROUP_URL=
GROUP_TITLE=группа

# Куда вести на регистрацию, если клан на сайте ещё не найден
SITE_URL=https://bb-squad.ru/clans

# Имя клана на сайте (не чужой isExternal)
CLAN_NAME=BlackBerry
# Необязательно. Если пусто, ищем только по имени.
CLAN_TAG=

# Telegram id кадровиков через запятую. Они сразу могут назначать других.
HR_BOOTSTRAP_IDS=

# Как часто сверять сайт и подписки, секунды
POLL_SEC=60

# На Plaza api.telegram.org закрыт — прокси через CF Worker (см. scripts/cf-bb-tg-relay-worker.js):
# TELEGRAM_API_BASE=https://bb-squad-alert.lgsghla.workers.dev/s/RELAY_SECRET/bot

# База бота. По умолчанию recruit-bot/data/recruit.sqlite
# DB_PATH=

# Если пусто, DATABASE_URL берётся из platform/.env (в чат и в алерты не пишется)
# DATABASE_URL=
